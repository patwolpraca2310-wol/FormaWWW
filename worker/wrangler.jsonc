{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "formawww-contact",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-17",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "FORM_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://formawww.pl",
    "FROM_EMAIL": "formularz@send.formawww.pl"
  },
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "formawww-contact",
      "database_id": "cef3e132-908b-4d56-9c99-012689b525b2"
    }
  ],
  "ratelimits": [
    {
      "name": "REQUEST_LIMITER",
      "namespace_id": "1001",
      "simple": {"limit": 5, "period": 60}
    },
    {
      "name": "SITE_LIMITER",
      "namespace_id": "1002",
      "simple": {"limit": 30, "period": 60}
    }
  ],
  "triggers": {"crons": ["17 * * * *"]},
  "observability": {"enabled": false}
}
